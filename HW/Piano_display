import pygame
import random

WIDTH = 4 + 1
HEIGHT = 20

colors = [
    (0, 0, 0),
    (120, 37, 179),
    (100, 179, 179),
    (80, 34, 22),
    (80, 134, 22),
]


class Figure:
    x = 0
    y = 0

    figures = [
        [2,5,6,10], #left
        [2,5,6,7], #up
        [1,2,3,6], #down
        [1,5,6,9], #right
    ]
    text = [
        "Left",
        "Up",
        "Down",
        "Right"
    ]

    def __init__(self, index, type):
        self.x = 3 * index - 1 #note
        self.y = 0
        self.type = index #lenght of note
        self.color = index
        self.direc = index


    def image(self):
        return self.figures[self.type]
    
    def direction(self):
        return self.text[self.direc]


class Tetris:
    def __init__(self, height, width):
        self.state = "start"
        self.score = 0
        self.field = []
        self.height = 0
        self.width = 0
        self.x = 100
        self.y = 60
        self.zoom = 13
        self.figure = []
        self.fuck = False
    
        self.height = height
        self.width = width
        self.field = []
        self.state = "start"
        for i in range(height):
            new_line = []
            for j in range(width):
                new_line.append(0)
            self.field.append(new_line)

    def new_figure(self):
        self.figure.append(Figure(random.randint(0,3),random.randint(0,3)))
        if self.figure[0].y > 19:
            self.figure.pop(0)
            if not self.fuck and (self.score - 1) >= 0:
                self.score -= 1
            self.fuck = False
        
        



    def go_down(self):
        for k in range(len(self.figure)):
            self.figure[k].y += 0.1
            
            




# Initialize the game engine
pygame.init()
print(" starting ")

# Define some colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GRAY = (128, 128, 128)
RED = (255, 0, 0)

size = (1400, 600) # width, height
screen = pygame.display.set_mode(size)

pygame.display.set_caption("Jazz")

# Loop until the user clicks the close button.
done = False
clock = pygame.time.Clock()
fps = 60 #bpm
game = Tetris(HEIGHT, WIDTH) #height, width
counter = 0

pressing_down = False

while not done:
    counter += 1
    if counter > 100000:
        counter = 0

    if counter % (50) == 0 or pressing_down:
        if game.state == "start":
            game.new_figure()
            
    
    if counter % (1) == 0 or pressing_down:
        if game.state == "start":
            game.go_down()

    if game.figure:
        if game.figure[0].y > 15 and game.figure[0].x == -1:
            print("Left")
        if game.figure[0].y > 15 and game.figure[0].x == 2:
            print("Up")
        if game.figure[0].y > 15 and game.figure[0].x == 5:
            print("down")
        if game.figure[0].y > 15 and game.figure[0].x == 8:
            print("Right")
            


    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            done = True
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                game.__init__(HEIGHT, WIDTH)
            if event.key == pygame.K_LEFT:
                if game.figure[0].y > 15 and game.figure[0].x == -1:
                    game.score += 1
                    game.figure.pop(0)
                elif game.score - 1 > 0:
                    game.score -= 1
                    game.fuck = True
            if event.key == pygame.K_UP:
                if game.figure[0].y > 15 and game.figure[0].x == 2:
                    game.score += 1
                    game.figure.pop(0)
                elif game.score - 1 > 0:
                    game.score -= 1
                    game.fuck = True
            if event.key == pygame.K_DOWN:
                if game.figure[0].y > 15 and game.figure[0].x == 5:
                    game.score += 1
                    game.figure.pop(0)
                elif game.score - 1 > 0:
                    game.score -= 1
                    game.fuck = True
            if event.key == pygame.K_RIGHT:
                if game.figure[0].y > 15 and game.figure[0].x == 8:
                    game.score += 1
                    game.figure.pop(0)
                elif game.score - 1 > 0:
                    game.score -= 1
                    game.fuck = True
            


    screen.fill(WHITE)

    for i in range(game.height):
        for j in range(game.width):
            pygame.draw.rect(screen, GRAY, [game.x + game.zoom * 3* j, game.y + game.zoom * i, 1, game.zoom], 1)
    pygame.draw.line(screen, GRAY, [game.x + game.zoom * 0, game.y + game.zoom* 0], [game.x + game.zoom* 12, game.y + game.zoom * 0] )
    pygame.draw.line(screen, GRAY, [game.x + game.zoom * 0, game.y + game.zoom * 20], [game.x + game.zoom* 12, game.y + game.zoom * 20] )
    pygame.draw.line(screen, RED, [game.x + game.zoom * 0, game.y + game.zoom * 15], [game.x + game.zoom* 12, game.y + game.zoom * 15] )

    font = pygame.font.SysFont('Calibri', 10, True, False)
    font1 = pygame.font.SysFont('Calibri', 65, True, False)

    if game.figure is not None:
        for i in range(4):
            for j in range(4):
                p = i * 4 + j
                for k in range(len(game.figure)):              
                    if p in game.figure[k].image():
                        pygame.draw.rect(screen, colors[game.figure[k].color],
                            [game.x + game.zoom * (j + game.figure[k].x) + 1,
                            game.y + game.zoom * (i + game.figure[k].y) + 1,
                            game.zoom - 2, game.zoom - 2])
    if game.figure is not None:
        for k in range(len(game.figure)):
            screen.blit(font.render(game.figure[k].direction(), True, RED), [game.x + game.zoom * (game.figure[k].x + 2),
                game.y + game.zoom * (game.figure[k].y + 1)  ])

    text = font1.render("Score: " + str(game.score), True, BLACK)

    screen.blit(text, [0, 0])
    #text_game_over1 = font1.render("Press ESC", True, (255, 215, 0))

    pygame.display.flip()
    clock.tick(fps)

pygame.quit()
